# Core values are deployment-specific; this file lists the optional WB ecosystem bridge.
DATABASE_URL=postgresql://crm:CHANGE_ME@localhost:5432/crm
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3000

# Hub SSO tenant binding
HUB_URL=http://localhost:4100
HUB_INSTANCE_ID=
HUB_ORG_ID=
HUB_SSO_CLIENT_ID=crm
HUB_SSO_SECRET=
HUB_WEBHOOK_SECRET=
# Publiczny adres WB Platform — link "Przejdz do WB Platform" na /admin-login
HUB_PUBLIC_URL=https://wb-partners.pl

# Panel firmowy dziala wylacznie przez SSO z WB Platform.
# Ustaw na "true" tylko awaryjnie, gdy Hub jest niedostepny — odblokowuje
# logowanie haslem lokalnym wraz z bramka ADMIN_SECRET_TOKEN.
CRM_ALLOW_LOCAL_STAFF_LOGIN=false
ADMIN_SECRET_TOKEN=

# CRM meetings -> Rytm full snapshots (optional)
RYTM_API_URL=http://localhost:4200
RYTM_ECOSYSTEM_SECRET=
RYTM_MEETING_DURATION_MIN=60